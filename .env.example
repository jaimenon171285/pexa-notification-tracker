# Microsoft Graph API Configuration
# Get these from Azure Portal > App Registrations
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

# The mailbox to read PEXA notifications from
PEXA_MAILBOX=rahul@legalworld.com.au

# The Outlook folder name containing PEXA emails
PEXA_FOLDER_NAME=PEXA Notifications

# How often to check for new emails (in minutes)
SYNC_INTERVAL_MINUTES=5

# Flask secret key (change this to a random string)
SECRET_KEY=change-this-to-a-random-secret-key

# SharePoint Excel sharing URL (for Push to Spreadsheet feature)
# Get this from SharePoint > Share > Copy Link
SHAREPOINT_EXCEL_URL=

# App port
PORT=5000
